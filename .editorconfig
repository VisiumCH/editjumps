# Editor defaults, so a contributor's editor agrees with the tools that gate CI
# (ruff for Python, and a Makefile that only works with real tabs).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ruff's configured line-length (see [tool.ruff] in pyproject.toml). Keep the two in step.
[*.py]
max_line_length = 120

# Recipe lines must start with a hard tab or make refuses to run them.
[Makefile]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{csv,tsv,fasta,fa}]
insert_final_newline = false
trim_trailing_whitespace = false
