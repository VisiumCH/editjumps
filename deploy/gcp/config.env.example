# GCP architecture parameters for editjumps — the single source of truth for the
# storage + DVC + MLflow migration. Copy to `config.env` (gitignored), fill in, then:
#
#     gcloud auth application-default login        # one-time (ADC)
#     source deploy/gcp/config.env
#     bash deploy/gcp/build_image.sh               # build + push the MLflow server image
#     cd deploy/gcp/terraform && terraform apply   # buckets, Cloud SQL, Cloud Run, DVC remote
#
# See docs/gcp_setup.md for the full runbook — it is Terraform, not shell scripts.

export PROJECT_ID="your-gcp-project"
export REGION="us-central1"

# GCS buckets (names are globally unique across all of GCS — pick your own).
#   DVC_BUCKET     backs the DVC remote (all of data/**, versioned by dvc.lock).
#   MLFLOW_BUCKET  backs MLflow artifacts (models, figures) served by the server.
export DVC_BUCKET="gs://CHANGEME-profound-dvc"
export MLFLOW_BUCKET="gs://CHANGEME-profound-mlflow"

# Cloud SQL (Postgres) — the durable backend store for the MLflow tracking server.
export SQL_INSTANCE="profound-mlflow"
export SQL_DB="mlflow"
export SQL_USER="mlflow"
# SQL_PASSWORD is not set here and is never written to disk: Terraform generates it and stores it
# in Secret Manager, and the MLflow service reads it from there at deploy time.
