      - family-names: Ferragu
      - family-names: Ziegler
      - family-names: Aziznejad
      - family-names: Bixby
    year: 2026
    notes: "arXiv:2603.11703 - the paper this repository reproduces."
  - type: article
    title: "Edit Flows: Flow Matching with Edit Operations"
    authors:
